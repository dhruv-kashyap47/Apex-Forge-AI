# ApexForge AI — Environment Configuration Example
# Copy this file to .env and replace every placeholder before deployment.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apexforge
POSTGRES_USER=apexforge_user
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Application
APP_ENV=development
APP_SECRET_KEY=replace_with_a_long_random_secret_key_at_least_32_chars
APP_ACCESS_CODE=
LOG_LEVEL=INFO
USE_DEMO_STORE=true

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Thresholds
THRESHOLD_AUTO_LINK=0.92
THRESHOLD_REVIEW=0.65

# Seeding
SEED_RECORDS=10000
SEED_PIN_CODES=560001,560058
